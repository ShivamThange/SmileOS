# DentalOS backend — copy to .env and fill in. Sensible defaults let the server
# boot for local development without every integration configured.

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Data stores — the server boots in a degraded (no-DB) mode if these are absent,
# so health checks and route wiring can be exercised without infrastructure.
MONGO_URI=mongodb://127.0.0.1:27017/dentalos
REDIS_URL=redis://127.0.0.1:6379

# Auth — CHANGE THESE IN PRODUCTION. Separate secrets per token audience.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10

# CORS — comma-separated allowed origins for the Console/Portal/Site frontends.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Default demo tenant (used by the seed script).
DEFAULT_CLINIC_SLUG=meher-dental-care

# Integration credentials are referenced, never committed. Point these at your
# secrets store in production. Left blank, the relevant services no-op + log.

# Email — set RESEND_API_KEY for real transactional delivery (incl. OTP) via the
# Resend HTTP API. EMAIL_FROM must be a Resend-verified sender; the default
# onboarding@resend.dev only delivers to the Resend account owner's address.
# SMTP_URL is recognised but no SMTP transport is bundled — prefer RESEND_API_KEY.
RESEND_API_KEY=
EMAIL_FROM=DentalOS <onboarding@resend.dev>
SMTP_URL=

# Payments — Razorpay. With key id + secret set, /payments/create-order calls the
# real Orders API. The webhook secret verifies inbound payment webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# Storage — S3-compatible (AWS S3, Supabase Storage, etc.). With all four set,
# presigned upload/download URLs are real SigV4 URLs. S3_REGION defaults to
# us-east-1; set it to your bucket's region (Supabase: your project region).
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
