# DentalOS frontend — copy to .env.local for overrides. All keys must be VITE_*.

# Base URL for the API. Leave blank in dev to use the Vite proxy (same-origin
# → /api/v1, so the httpOnly refresh cookie flows without CORS). Set to a full
# origin for a deployed build, e.g. https://api.dentalos.app/api/v1
VITE_API_URL=

# Default clinic slug sent as the X-Clinic-Slug header on public (unauthenticated)
# calls — the Site, Cost Calculator and Booking. Must match a seeded clinic.
VITE_CLINIC_SLUG=meher-dental-care

# Override the dev proxy target if the API server runs somewhere other than :4000.
VITE_PROXY_TARGET=http://localhost:4000
