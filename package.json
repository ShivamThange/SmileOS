{
  "name": "dentalos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run check:enums",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "sync:enums": "node scripts/enums-mirror.mjs",
